# Copy to keystore.properties (git-ignored) to sign release builds with your
# upload key. Paths are relative to this folder (android/).
#
# Make a key once (keep it and its passwords safe: Google Play needs the same
# upload key for every update, unless you ask Google to reset it):
#   keytool -genkeypair -v -keystore upload.jks -keyalg RSA -keysize 4096 -validity 10000 -alias upload
storeFile=upload.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
